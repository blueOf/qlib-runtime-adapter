{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-project-research-route-v1",
  "title": "Deterministic natural-language research route",
  "type": "object",
  "required": ["schema", "request", "experiment_id", "stage", "matched_intents", "status"],
  "properties": {
    "schema": {"const": "quant-project-research-route-v1"},
    "request": {"type": "string", "minLength": 1},
    "experiment_id": {"type": "string", "pattern": "^EXP[0-9]+_V[1-9][0-9]*$"},
    "stage": {"enum": ["factor", "model", "signal", "strategy", "full"]},
    "execution_engine": {"enum": ["deterministic", "qlib"]},
    "matched_intents": {"type": "array", "minItems": 1, "items": {"enum": ["factor", "model", "signal", "strategy", "full"]}},
    "status": {"const": "resolved"}
  }
}
