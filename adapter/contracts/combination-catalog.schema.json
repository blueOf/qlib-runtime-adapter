{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-project-combination-catalog-v1",
  "title": "Research combination catalog",
  "type": "object",
  "required": ["schema_version", "combinations"],
  "properties": {
    "schema_version": {"const": "quant-project-combination-catalog-v1"},
    "combinations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "sources"],
        "properties": {
          "id": {"type": "string", "pattern": "^EXP[0-9]+_V[1-9][0-9]*$"},
          "name": {"type": "string", "minLength": 1},
          "sources": {
            "type": "object",
            "required": ["factor", "signal", "strategy"],
            "properties": {
              "factor": {"type": "string", "pattern": "^FAC_[A-Z0-9_]+_V[1-9][0-9]*$"},
              "signal": {"type": "string", "pattern": "^SIG_[A-Z0-9_]+_V[1-9][0-9]*$"},
              "strategy": {"type": "string", "pattern": "^STR_[A-Z0-9_]+_V[1-9][0-9]*$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
