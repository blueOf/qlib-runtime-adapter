{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-project-research-input-v1",
  "title": "Layered research input",
  "type": "object",
  "required": ["schema", "context"],
  "properties": {
    "schema": {"const": "quant-project-research-input-v1"},
    "context": {
      "type": "object",
      "required": ["universe", "snapshot_compatible"],
      "properties": {
        "market": {"type": "string", "minLength": 1},
        "universe": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "start": {"type": ["string", "null"]},
        "end": {"type": ["string", "null"]},
        "research_release": {"type": ["string", "null"]},
        "market_data_revision": {"type": ["string", "null"]},
        "corporate_action_version": {"type": ["string", "null"]},
        "calendar_version": {"type": ["string", "null"]},
        "snapshot_compatible": {"type": "boolean"},
        "data_mode": {"enum": ["snapshot_compatible", "point_in_time"]},
        "as_of": {"type": ["string", "null"]},
        "as_of_policy": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "factor_dataset": {"type": "string", "minLength": 1},
    "session_window": {
      "type": "object",
      "description": "Newest-first session positions. after=60 and through=120 selects positions 61 through 120.",
      "required": ["after", "through"],
      "properties": {
        "after": {"type": "integer", "minimum": 0},
        "through": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "candidate_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signal_id", "timestamp", "symbol", "score", "rank", "percentile", "side", "source_factor_id", "source_factor_score_id"],
        "properties": {
          "signal_id": {"type": "string", "minLength": 1},
          "timestamp": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "score": {"type": "number"},
          "rank": {"type": "integer", "minimum": 1},
          "percentile": {"type": "number", "minimum": 0, "maximum": 1},
          "side": {"enum": ["LONG", "SHORT"]},
          "source_factor_id": {"type": "string", "minLength": 1},
          "source_factor_score_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "symbol", "score"],
        "properties": {
          "timestamp": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "score": {"type": "number"},
          "groups": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
        }
      }
    },
    "labels": {"type": "object"},
    "groups": {"type": "object", "additionalProperties": {"type": ["object", "string", "number"]}},
    "regimes": {"type": "object", "additionalProperties": {"type": ["string", "number"]}},
    "regime_source": {
      "type": "object",
      "required": ["prices"],
      "properties": {
        "benchmark_id": {"type": "string"},
        "window": {"type": "integer", "minimum": 2},
        "bull_threshold": {"type": "number"},
        "bear_threshold": {"type": "number"},
        "high_volatility_threshold": {"type": "number", "exclusiveMinimum": 0},
        "prices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["timestamp", "close"],
            "properties": {
              "timestamp": {"type": "string", "minLength": 1},
              "close": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        }
      }
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "symbol"],
        "properties": {
          "timestamp": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "exchange": {"type": "string", "minLength": 1},
          "code": {"type": "string", "pattern": "^[0-9]{6}$"},
          "listing_date": {"type": "string", "format": "date"},
          "is_st": {"type": "boolean"},
          "trade_status": {"type": ["string", "integer"]},
          "previous_close": {"type": "number", "exclusiveMinimum": 0},
          "reference_close": {"type": "number", "exclusiveMinimum": 0},
          "corporate_action": {"type": "boolean"},
          "special_price_limit_status": {"type": "string"},
          "price": {"type": "number"},
          "open": {"type": "number"},
          "high": {"type": "number"},
          "low": {"type": "number"},
          "close": {"type": "number"},
          "volume": {"type": "number", "minimum": 0},
          "suspended": {"type": "boolean"},
          "trading_status": {"type": "string"},
          "limit_buy_locked": {"type": "boolean"},
          "limit_sell_locked": {"type": "boolean"},
          "upper_limit_price": {"type": "number", "exclusiveMinimum": 0},
          "lower_limit_price": {"type": "number", "exclusiveMinimum": 0},
          "ask_volume": {"type": "number", "minimum": 0},
          "bid_volume": {"type": "number", "minimum": 0}
        },
        "anyOf": [{"required": ["price"]}, {"required": ["open", "high", "low", "close"]}]
      }
    },
    "trading_calendar": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "format": "date"},
      "description": "Exchange session dates covering every listing date through each supplied market bar."
    },
    "corporate_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "symbol"],
        "properties": {
          "timestamp": {"type": "string", "minLength": 1},
          "symbol": {"type": "string", "minLength": 1},
          "cash_dividend_per_share": {"type": "number"},
          "bonus_share_ratio": {"type": "number"},
          "split_multiplier": {"type": "number", "exclusiveMinimum": 0},
          "rights_share_ratio": {"type": "number"},
          "rights_price": {"type": "number"}
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
          "parameter_overrides": {
            "type": "object",
            "properties": {
              "portfolio": {"type": "object"},
              "entry": {"type": "object"},
              "exit": {"type": "object"},
              "execution": {"type": "object"},
              "accounting": {"type": "object"}
            },
            "additionalProperties": false
          },
          "start_offset": {"type": "integer", "minimum": 0},
          "cost_multiplier": {"type": "number", "minimum": 0},
          "slippage_multiplier": {"type": "number", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "oneOf": [
    {"required": ["scores"], "not": {"anyOf": [{"required": ["factor_dataset"]}, {"required": ["candidate_signals"]}]}},
    {"required": ["factor_dataset"], "not": {"anyOf": [{"required": ["scores"]}, {"required": ["candidate_signals"]}]}},
    {"required": ["candidate_signals"], "not": {"anyOf": [{"required": ["scores"]}, {"required": ["factor_dataset"]}]}}
  ],
  "allOf": [
    {"not": {"required": ["regimes", "regime_source"]}}
  ]
}
