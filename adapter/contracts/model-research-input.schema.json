{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-project-model-research-input-v1",
  "title": "Generic model research input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "context",
    "factor_set",
    "models",
    "split_policy",
    "signal",
    "execution_strategy",
    "budget",
    "rows"
  ],
  "properties": {
    "schema": {
      "const": "quant-project-model-research-input-v1"
    },
    "operation": {
      "enum": [
        "evaluate",
        "inference"
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "data_mode",
        "as_of",
        "universe"
      ],
      "properties": {
        "data_mode": {
          "enum": [
            "snapshot_compatible",
            "point_in_time"
          ]
        },
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "universe": {
          "type": "string",
          "minLength": 1
        },
        "random_seed": {
          "type": "integer"
        }
      }
    },
    "factor_set": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "quant-project-factor-set-v1",
          "type": "object",
          "required": [
            "id",
            "factors"
          ],
          "properties": {
            "schema_version": {
              "const": "quant-project-factor-set-v1"
            },
            "id": {
              "type": "string",
              "pattern": "^FSET_[A-Z0-9_]+_V[1-9][0-9]*$"
            },
            "factors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "dtype",
                  "higher_is_better",
                  "missing_policy",
                  "config_sha256"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^FAC_[A-Z0-9_]+_V[1-9][0-9]*$"
                  },
                  "dtype": {
                    "const": "float64"
                  },
                  "higher_is_better": {
                    "type": "boolean"
                  },
                  "missing_policy": {
                    "const": "fail"
                  },
                  "config_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "quant-project-model-spec-v1",
            "type": "object",
            "required": [
              "id",
              "adapter",
              "fit_policy"
            ],
            "properties": {
              "schema_version": {
                "const": "quant-project-model-spec-v1"
              },
              "id": {
                "type": "string",
                "pattern": "^MOD_[A-Z0-9_]+_V[1-9][0-9]*$"
              },
              "adapter": {
                "type": "string",
                "minLength": 1
              },
              "fit_policy": {
                "enum": [
                  "no_fit",
                  "train_per_fold",
                  "frozen_artifact"
                ]
              },
              "execution_status": {
                "enum": [
                  "executable",
                  "reference_only"
                ]
              },
              "input_factor_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "params": {
                "type": "object"
              },
              "resources": {
                "type": "object"
              },
              "artifact": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "target_field": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "target_contract": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        ]
      }
    },
    "label": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "quant-project-label-spec-v1",
          "type": "object",
          "required": [
            "id",
            "field",
            "horizon_sessions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^LBL_[A-Z0-9_]+_V[1-9][0-9]*$"
            },
            "field": {
              "type": "string",
              "minLength": 1
            },
            "horizon_sessions": {
              "type": "integer",
              "minimum": 0
            },
            "availability_field": {
              "const": "available_at"
            }
          }
        }
      ]
    },
    "split_policy": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "quant-project-split-policy-v1",
          "type": "object",
          "required": [
            "id",
            "sessions",
            "folds",
            "purge_sessions",
            "embargo_sessions"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^SPLIT_[A-Z0-9_]+_V[1-9][0-9]*$"
            },
            "sessions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "date"
              }
            },
            "purge_sessions": {
              "type": "integer",
              "minimum": 0
            },
            "embargo_sessions": {
              "type": "integer",
              "minimum": 0
            },
            "folds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "inference_window"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "train_window": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "inference_window": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "inner_folds": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "train_window",
                        "inference_window"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "evaluation_policy": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "quant-project-evaluation-policy-v1",
          "type": "object",
          "required": [
            "id",
            "metric"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^EVAL_[A-Z0-9_]+_V[1-9][0-9]*$"
            },
            "metric": {
              "enum": [
                "mse",
                "rank_ic",
                "log_loss"
              ]
            },
            "mode": {
              "enum": [
                "fixed_comparison",
                "nested_walk_forward"
              ]
            },
            "minimum_label_coverage": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "baseline_model_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "signal": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "id",
            "source"
          ]
        }
      ]
    },
    "execution_strategy": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "required": [
            "id"
          ]
        }
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_wall_seconds",
        "max_threads",
        "max_train_rows",
        "max_attempts"
      ],
      "properties": {
        "max_wall_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_threads": {
          "type": "integer",
          "minimum": 1
        },
        "max_train_rows": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "symbol"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "minLength": 1
          },
          "symbol": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "timestamp",
          "symbol",
          "available_at"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "inference"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "labels"
              ]
            },
            {
              "required": [
                "label"
              ]
            },
            {
              "required": [
                "evaluation_policy"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "label",
          "evaluation_policy",
          "labels"
        ]
      }
    }
  ]
}
